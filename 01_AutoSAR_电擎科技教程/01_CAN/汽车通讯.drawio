          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-48" value="错误处理机制" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
