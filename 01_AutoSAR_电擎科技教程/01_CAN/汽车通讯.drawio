          <mxGeometry x="307" y="304" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8Dn5a-7j8ZJaSRBAyS9S-20" value="将来自下层通信接口（如CanIf）或传输协议模块（如CanTp）的I-PDU，路由至上层模块（如COM、DCM）" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="291" y="-16" width="434" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8Dn5a-7j8ZJaSRBAyS9S-22" value="核心任务是基于静态配置的路由表，将I-PDU（交互层协议数据单元）从源模块路由到一个或多个目标模块，实现通信层间的解耦。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" vertex="1" parent="1">
          <mxGeometry x="-800" y="52" width="364" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8Dn5a-7j8ZJaSRBAyS9S-25" value="为需要分段收发的长报文（如UDS诊断）提供路由支持" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="307" y="410" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8Dn5a-7j8ZJaSRBAyS9S-27" value="支持由下层模块触发的数据请求传输机制" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="307" y="508" width="540" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Axd2-aDR9B8oenzdcJlG" name="CanIf">
    <mxGraphModel dx="2234" dy="1286" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4000" pageHeight="4000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="cVzYSe8W-2QIQ15OGR4Y-8" target="cVzYSe8W-2QIQ15OGR4Y-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-2" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="cVzYSe8W-2QIQ15OGR4Y-8" target="cVzYSe8W-2QIQ15OGR4Y-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-7" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.475;entryY=1;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;entryPerimeter=0;" edge="1" parent="1" source="cVzYSe8W-2QIQ15OGR4Y-8" target="cVzYSe8W-2QIQ15OGR4Y-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-8" value="CanIf" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-558" y="175" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-9" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="cVzYSe8W-2QIQ15OGR4Y-10" target="cVzYSe8W-2QIQ15OGR4Y-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-10" value="数据通信功能" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-53" y="-16" width="268" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-11" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="cVzYSe8W-2QIQ15OGR4Y-12" target="cVzYSe8W-2QIQ15OGR4Y-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-12" value="硬件控制与诊断功能" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-89" y="320.5" width="268" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-13" value="&lt;div&gt;控制器与收发器模式管理：提供接口来控制CAN控制器（Can Controller）和收发器（Trcv）的工作模式，如正常、睡眠、待机等。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;波特率切换：支持在运行时切换CAN总线的通信波特率。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;睡眠与唤醒管理：支持ECU和CAN网络的休眠与唤醒流程。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Bus Off处理与通知：检测并处理CAN控制器的Bus Off状态，并通知上层模块。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;PDU通道模式控制：可以对特定的PDU通道进行单独的模式控制。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;错误通知：将底层CAN驱动检测到的错误（如DLC长度不匹配）向上层报告。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;软件滤波：在接收路径上，CanIf可以根据配置的CAN ID和DLC等信息进行软件滤波，只将有效的L-PDU分发给上层。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="347" y="179" width="434" height="371" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-24" value="&lt;div&gt;主要负责上层数据与硬件驱动之间的路由和转换。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;发送请求与确认 (Transmit &amp;amp; Confirmation)：接收上层（如PduR）的发送请求（CanIf_Transmit），将L-PDU交给底层CAN驱动（CanDrv）发送。发送完成后，通过回调函数（&amp;lt;User_TxConfirmation&amp;gt;）向上层报告结果。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;接收指示 (Receive Indication)：接收来自CAN驱动的L-PDU，并根据静态配置的路由表，将其分发（Dispatch）给对应的上层模块（如PduR、CanNm）。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;发送缓冲 (Transmit Buffering)：当底层驱动（CanDrv）繁忙无法立即处理发送请求时，CanIf可以选择将L-PDU暂存在自己的缓冲区（CanIfBufferCfg）中，待总线空闲时再由CanIf自动重发，上层模块无需感知此过程。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="341" y="-125" width="434" height="268" as="geometry" />
        </mxCell>
        <mxCell id="cVzYSe8W-2QIQ15OGR4Y-25" value="核心职责是屏蔽底层CAN硬件（控制器、收发器）的差异，为上层（如PduR、CanNm、CanTp等）提供一套统一且标准化的接口来访问CAN网络" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;align=left;" vertex="1" parent="1">
          <mxGeometry x="-678" y="-1" width="364" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
