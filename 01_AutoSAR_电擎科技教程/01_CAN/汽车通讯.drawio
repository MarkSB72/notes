            <mxPoint x="-705" y="479" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-38" value="机制" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-769" y="454" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-43" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="ontKSbVevX5EzZ0Z-kZ5-40" target="ontKSbVevX5EzZ0Z-kZ5-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-40" value="位填充" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" vertex="1" parent="1">
          <mxGeometry x="14" y="262" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-42" value="在SOF到CRC之间，如果出现连续5个相同的位，就会插入一个极性相反的位&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;接收方识别后会删去&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="215" y="262" width="449" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-47" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="ontKSbVevX5EzZ0Z-kZ5-44" target="ontKSbVevX5EzZ0Z-kZ5-46">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-44" value="ID仲裁机制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" vertex="1" parent="1">
          <mxGeometry x="14" y="394" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-46" value="线与逻辑，当多个设备同时发送时，会逐位发送ID，显性位，逻辑0会覆盖隐性位，逻辑1。发送隐性位的设备会立即停止，切换到接收状态。&lt;br&gt;这个机制得出ID越小，优先级越高" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="215" y="394" width="449" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-53" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="ontKSbVevX5EzZ0Z-kZ5-48" target="ontKSbVevX5EzZ0Z-kZ5-50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ontKSbVevX5EzZ0Z-kZ5-57" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;" edge="1" parent="1" source="ontKSbVevX5EzZ0Z-kZ5-48" target="ontKSbVevX5EzZ0Z-kZ5-54">
          <mxGeometry relative="1" as="geometry" />
